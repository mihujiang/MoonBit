import {
  "moonbitlang/core/env",
  "mizchi/llm",
  "mizchi/llm/openai",
  "mizchi/llm/tools" @llm_tools,
  "weopqrst/agent/tools",
  "weopqrst/agent/config",
  "weopqrst/agent/observability",
  "weopqrst/agent/memory",
}

pkgtype(kind: "executable")

options(
  targets: {
    "io_js.mbt": [ "js" ],
    "io_native.mbt": [ "native" ],
    "io_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
